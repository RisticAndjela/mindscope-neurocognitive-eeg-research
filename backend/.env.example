APP_NAME=MindScope Backend
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
SUPABASE_URL=https://YOUR_SUPABASE_HOST.supabase.co
SUPABASE_JWKS_URL=https://YOUR_SUPABASE_HOST.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
